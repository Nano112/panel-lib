{
  "schemaVersion": 1,
  "id": "panellib",
  "version": "${version}",
  "name": "panel-lib",
  "description": "Shared dockable panels for Minecraft mods.",
  "authors": [
    "Harrison"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.harrison.panellib.PanelLibClient"
      }
    ]
  },
  "mixins": [
    {
      "config": "panellib.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk_min}",
    "minecraft": "${minecraft_compat}",
    "java": ">=${java_version}"
  },
  "custom": {
    "panellib": {
      "entrypoint": "panellib"
    },
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "contact": {
    "sources": "https://github.com/Nano112/panel-lib",
    "issues": "https://github.com/Nano112/panel-lib/issues"
  }
}
